# ==============================================================================
# CurrencyHub Backend Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust values for your local environment:
#   cp .env.example .env
#
# DO NOT commit real credentials, passwords, or API keys to version control.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Microsoft SQL Server Configuration
# Provide either a complete SQLAlchemy connection string via DATABASE_URL
# or individual connection parameters.
#
# Examples:
# Windows Authentication (Trusted Connection):
# DATABASE_URL=mssql+pyodbc:///?odbc_connect=DRIVER={ODBC+Driver+18+for+SQL+Server};SERVER=localhost;DATABASE=currencyhub;Trusted_Connection=yes;TrustServerCertificate=yes
#
# SQL Server Authentication:
# DATABASE_URL=mssql+pyodbc://db_user:db_password@localhost:1433/currencyhub?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
DATABASE_URL=mssql+pyodbc:///?odbc_connect=DRIVER={ODBC+Driver+18+for+SQL+Server};SERVER=localhost;DATABASE=currencyhub;Trusted_Connection=yes;TrustServerCertificate=yes
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=currencyhub
DB_USER=placeholder_db_user
DB_PASSWORD=placeholder_db_password
DB_TRUST_SERVER_CERTIFICATE=true

# National Bank of Moldova (BNM) Provider Configuration
BNM_BASE_URL=https://www.bnm.md/en/official_exchange_rates
BNM_TIMEOUT_SECONDS=10
BNM_MAX_RETRIES=3

# CoinGecko-compatible Cryptocurrency Provider Configuration
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=placeholder_coingecko_api_key
COINGECKO_TIMEOUT_SECONDS=10
COINGECKO_MAX_RETRIES=3

# CORS Configuration
# Comma-separated list of allowed origins for local frontend development
# Angular web client typically runs at http://localhost:4200
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
